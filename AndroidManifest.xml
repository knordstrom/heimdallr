<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.callscreener">

    <!-- =========================================================
         Permissions
         ========================================================= -->

    <!--
        Required for CallScreeningService to be invoked by Android.
        The user must also designate this app as the call screener
        via TelecomManager.requestChangeDefaultCallScreeningApp() —
        handled in onboarding (see OnboardingActivity).
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Step 5: Show call screening result notifications.
        Runtime-requested in MainActivity on API 33+; silently skipped if denied.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />

    <!--
        Lets us read the caller's number inside onScreenCall().
        Declared here; runtime-requested in onboarding.
    -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!--
        Required for BOOT_COMPLETED receiver.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        Step 2+: microphone access for recording caller audio during screening.
        Runtime-requested after the dialer role is granted.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
        Step 2+: needed to run ScreeningInCallService as a foreground service
        with microphone access while a call is active.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- =========================================================
         Application
         ========================================================= -->

    <application
        android:name=".CallScreenerApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CallScreener">

        <!-- =====================================================
             CallScreeningService
             The core service. Android binds to this when a call
             arrives. The BIND_SCREENING_SERVICE permission ensures
             only the system can bind to it.
             ===================================================== -->
        <service
            android:name=".service.CallScreenerService"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
            <meta-data
                android:name="android.telecom"
                android:resource="@xml/call_screening_service" />
        </service>

        <!-- =====================================================
             ScreeningInCallService (Step 2+)
             Answers calls flagged by CallScreenerService, plays a
             TTS greeting, and records the caller's response.
             Requires this app to be the default phone app (ROLE_DIALER).
             BIND_IN_CALL_SERVICE ensures only the system can bind to it.
             ===================================================== -->
        <service
            android:name=".service.ScreeningInCallService"
            android:exported="true"
            android:permission="android.permission.BIND_IN_CALL_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_UI"
                android:value="false" />
        </service>

        <!-- =====================================================
             NotificationActionReceiver (Step 5)
             Handles "Block number" taps from screening result notifications.
             exported=false: only this app can send these intents (setPackage guard).
             ===================================================== -->
        <receiver
            android:name=".service.NotificationActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.callscreener.action.BLOCK" />
            </intent-filter>
        </receiver>

        <!-- =====================================================
             BootReceiver
             ===================================================== -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- =====================================================
             Activities (stubs — to be implemented in later steps)
             ===================================================== -->

        <!-- Entry point: asks user to set this app as the call screener -->
        <activity
            android:name=".ui.OnboardingActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Main screen: blocked call history + blocklist management -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="false" />

        <!-- Linked from call_screening_service.xml — required by telecom -->
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="true" />

    </application>

</manifest>
